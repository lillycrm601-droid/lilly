# Environment variables
# Copy this file to .env and adjust as needed:  cp .env.example .env

SECRET_KEY="django-insecure-dev-key-please-change-in-production"
ENV_TYPE="dev"
DEBUG=True
DOMAIN_NAME="http://localhost:8000"
SWAGGER_ROOT_URL="http://localhost:8000"

# AWS (only needed for production / S3 storage)
AWS_BUCKET_NAME=""
AWS_ACCESS_KEY_ID=""
AWS_SECRET_ACCESS_KEY=""
AWS_SES_REGION_NAME=""
AWS_SES_REGION_ENDPOINT=""

# DB
DBNAME="crm_db"
DBUSER="postgres"
DBPASSWORD="postgres"
DBHOST="localhost"
DBPORT="5432"

# Sentry (optional)
SENTRY_DSN=""

# Celery
CELERY_BROKER_URL="redis://localhost:6379/0"
CELERY_RESULT_BACKEND="redis://localhost:6379/0"

# Google OAuth (leave blank to disable)
# Get from Google Cloud Console (APIs & Services > Credentials > OAuth 2.0 Client IDs)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GOOGLE_REDIRECT_URI="http://localhost:5173/login"

# Email Configuration
# Options for EMAIL_BACKEND:
# - "anymail.backends.resend.EmailBackend" (Resend - recommended)
# - "anymail.backends.brevo.EmailBackend" (Brevo HTTP API)
# - "django.core.mail.backends.console.EmailBackend" (Prints emails to terminal, dev only)
# - "django_ses.SESBackend" (AWS SES)
EMAIL_BACKEND="anymail.backends.resend.EmailBackend"
RESEND_API_KEY=""
# For Resend testing: use "onboarding@resend.dev"
# For production: use a verified domain e.g. "noreply@yourdomain.com"
DEFAULT_FROM_EMAIL="onboarding@resend.dev"
ADMIN_EMAIL="admin@localhost"

FRONTEND_URL="http://localhost:5173"
ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
CSRF_TRUSTED_ORIGINS=http://localhost:5173

