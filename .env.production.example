# ==============================================================================
# LillyCRM Production Environment Configuration
# Copy this file to `.env.prod` on your server:
#   cp .env.production.example .env.prod
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Django Backend Security & Core Settings
# ------------------------------------------------------------------------------
# Generate a secret key with: python3 -c 'import secrets; print(secrets.token_urlsafe(50))'
SECRET_KEY=replace_with_a_secure_random_secret_key_here
DEBUG=False
ENV_TYPE=dev

# Allowed host domains and IP addresses (comma-separated, no spaces)
ALLOWED_HOSTS=yourdomain.com,www.yourdomain.com,backend,localhost,127.0.0.1

# Domain URLs (replace with your server's public domain or IP)
DOMAIN_NAME=https://yourdomain.com
FRONTEND_URL=https://yourdomain.com
SWAGGER_ROOT_URL=https://yourdomain.com

# ------------------------------------------------------------------------------
# 2. PostgreSQL Database (Docker Service)
# ------------------------------------------------------------------------------
DBNAME=crm_db
DBUSER=crm_user
DBPASSWORD=replace_with_a_secure_db_password
DBHOST=db
DBPORT=5432
DBSSLMODE=prefer

# Root Postgres Superuser (used by the db container to initialize the database)
POSTGRES_DB=crm_db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=replace_with_a_secure_postgres_root_password

# ------------------------------------------------------------------------------
# 3. Redis & Celery Background Tasks
# ------------------------------------------------------------------------------
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/0

# ------------------------------------------------------------------------------
# 4. Initial Administrator Account
# ------------------------------------------------------------------------------
ADMIN_EMAIL=admin@yourdomain.com
ADMIN_PASSWORD=replace_with_your_admin_login_password

# ------------------------------------------------------------------------------
# 5. Email Notifications (SMTP or API)
# ------------------------------------------------------------------------------
# Standard SMTP example:
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=your_email@gmail.com
EMAIL_HOST_PASSWORD=your_app_password
DEFAULT_FROM_EMAIL=noreply@yourdomain.com

# Or using Resend (optional):
# EMAIL_BACKEND=anymail.backends.resend.EmailBackend
# RESEND_API_KEY=re_your_resend_api_key

# ------------------------------------------------------------------------------
# 6. SvelteKit Frontend & AI Copilot
# ------------------------------------------------------------------------------
# Internal or public API URL
PUBLIC_DJANGO_API_URL=https://yourdomain.com

# Google Gemini API Key (for Lilly AI Copilot & Voice Call Mode)
GEMINI_API_KEY=your_gemini_api_key_here

# OpenRouter API Key (fallback model)
OPENROUTER_API_KEY=your_openrouter_api_key_here
