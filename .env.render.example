# Render environment reference for LillyCRM (see render.yaml — Blueprint sets most of these).
# Copy values from Dashboard → service → Environment after first deploy.
# NOTE: ENV_TYPE must stay "dev" on free Render — "prod" (crm/server_settings.py)
# requires AWS_BUCKET_NAME / AWS keys / SENTRY_DSN and will crash without them.

# Django
SECRET_KEY=<auto-generated by Blueprint — copy same value to lilly-worker!>
DEBUG=False
ENV_TYPE=dev
ALLOWED_HOSTS=.onrender.com
DOMAIN_NAME=https://lilly-backend.onrender.com
SWAGGER_ROOT_URL=https://lilly-backend.onrender.com
FRONTEND_URL=https://lilly-frontend.vercel.app

# Database — Neon (neon.tech → project → Connection Details → psql string)
# e.g. postgres://neondb_owner:<password>@ep-xxxx.us-east-2.aws.neon.tech/neondb?sslmode=require
DBNAME=neondb
DBUSER=neondb_owner
DBPASSWORD=<from Neon>
DBHOST=<endpoint>.aws.neon.tech
DBPORT=5432
DBSSLMODE=require

# Celery / Redis (free Upstash → https://console.upstash.com)
CELERY_BROKER_URL=redis://default:<password>@<host>:6379
CELERY_RESULT_BACKEND=redis://default:<password>@<host>:6379

# Email — Resend HTTP API (Render blocks SMTP ports, so HTTP API is required)
# Get key: Resend → API Keys → Create API Key (starts with re_)
EMAIL_BACKEND=anymail.backends.resend.EmailBackend
RESEND_API_KEY=<Resend API key, starts with re_>
# Use onboarding@resend.dev for testing, or your verified domain e.g. noreply@yourdomain.com
DEFAULT_FROM_EMAIL=onboarding@resend.dev
ADMIN_EMAIL=admin@localhost
ADMIN_PASSWORD=<auto-generated — see deploy logs, change after first login>

# CORS (tighten after frontend URL is known)
CORS_ALLOW_ALL=True
# CORS_ALLOWED_ORIGINS=https://your-frontend.vercel.app
# CSRF_TRUSTED_ORIGINS=https://your-frontend.vercel.app

# Google OAuth
GOOGLE_CLIENT_ID=<your-client-id.apps.googleusercontent.com>
GOOGLE_CLIENT_SECRET=<your-client-secret>
GOOGLE_REDIRECT_URI=https://your-frontend.vercel.app/login

# Frontend (Vercel → project settings → Environment Variables)
PUBLIC_DJANGO_API_URL=https://lilly-backend.onrender.com
